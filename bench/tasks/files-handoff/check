#!/usr/bin/env python3
import sys
import urllib.parse
import zipfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
from checklib import HOME, Checkpoints  # noqa: E402

c = Checkpoints()
marks = HOME / ".config/gtk-3.0/bookmarks"
lines = marks.read_text().splitlines() if marks.exists() else []
paths = {
    urllib.parse.unquote(urllib.parse.urlparse(ln.split(" ", 1)[0]).path).rstrip("/")
    for ln in lines
}
c.add("alpha bookmarked", str(HOME / "Projects/alpha") in paths, f"{len(lines)} bookmark(s)")
want = {"report.pdf", "notes.txt", "budget.ods"}
z = HOME / "Documents/handoff.zip"
try:
    names = {Path(n).name for n in zipfile.ZipFile(z).namelist() if not n.endswith("/")}
except (OSError, zipfile.BadZipFile) as exc:
    names = set()
    c.add("zip exists", False, str(exc)[:60])
else:
    c.add("zip exists", True)
c.add("exactly those three files", names == want, ", ".join(sorted(names)) or "empty")
c.guard("originals kept", all((HOME / "Documents" / n).exists() for n in want))
c.finish()
