#!/bin/bash
source "$(dirname "$0")/../../lib.sh"
target=$(window_workspace bench-target)
other=$(window_workspace bench-other)
if [[ $target == "3" && $other == "1" ]]; then
  verdict pass "bench-target on 3, bench-other on 1"
else
  verdict fail "bench-target on '${target}', bench-other on '${other}'"
fi
