#!/usr/bin/env python3
import csv
import re
import sys
import zipfile
from pathlib import Path
from xml.etree import ElementTree as ET

sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
from checklib import HOME, Checkpoints  # noqa: E402

NS = {"m": "http://schemas.openxmlformats.org/spreadsheetml/2006/main"}
FIXTURE = Path(__file__).resolve().parents[2] / "fixtures/docs/sales.csv"
c = Checkpoints()
path = HOME / "Documents/sales.xlsx"
try:
    z = zipfile.ZipFile(path)
    sheet = ET.fromstring(z.read("xl/worksheets/sheet1.xml"))
except (OSError, KeyError, zipfile.BadZipFile, ET.ParseError) as exc:
    c.guard("saved as xlsx", False, str(exc)[:80])
    for name in ("revenue formulas", "sorted", "header frozen"):
        c.add(name, False)
    c.finish()
strings = []
if "xl/sharedStrings.xml" in z.namelist():
    for si in ET.fromstring(z.read("xl/sharedStrings.xml")).findall("m:si", NS):
        strings.append("".join(t.text or "" for t in si.iter(f"{{{NS['m']}}}t")))
cells = {}
for cell in sheet.iter(f"{{{NS['m']}}}c"):
    ref, kind = cell.get("r"), cell.get("t")
    v, f = cell.find("m:v", NS), cell.find("m:f", NS)
    value = v.text if v is not None else None
    if kind == "s" and value is not None:
        value = strings[int(value)]
    elif kind == "inlineStr":
        value = "".join(t.text or "" for t in cell.iter(f"{{{NS['m']}}}t"))
    cells[ref] = (value, f is not None, (f.text or "") if f is not None else "")


def val(ref):
    return cells.get(ref, (None, False, ""))[0]


want = sorted(tuple(r) for r in list(csv.reader(FIXTURE.open()))[1:])
rows = []
for r in range(2, 2 + len(want)):
    rows.append((val(f"A{r}"), val(f"B{r}"), val(f"C{r}"), val(f"D{r}")))
got = sorted(
    (a, b, str(int(float(c_))) if c_ else c_, f"{float(d):g}" if d else d) for a, b, c_, d in rows
)
want_n = sorted((a, b, str(int(c_)), f"{float(d):g}") for a, b, c_, d in want)
c.guard(
    "data kept",
    got == want_n and val("A14") in (None, ""),
    "rows differ" if got != want_n else "extra rows",
)

ok_formula, revenue = True, []
for r in range(2, 2 + len(want)):
    value, has_f, text = cells.get(f"E{r}", (None, False, ""))
    try:
        expect = float(val(f"C{r}")) * float(val(f"D{r}"))
        rev = float(value)
    except (TypeError, ValueError):
        ok_formula = False
        break
    revenue.append(rev)
    refs_ok = not text or (re.search(rf"\bC{r}\b", text) and re.search(rf"\bD{r}\b", text))
    if not has_f or not refs_ok or abs(rev - expect) > 0.01:
        ok_formula = False
c.add(
    "revenue formulas",
    ok_formula and (val("E1") or "").strip().lower() == "revenue",
    f"E1={val('E1')!r}",
)
c.add("sorted", len(revenue) == len(want) and revenue == sorted(revenue, reverse=True))
pane = sheet.find(".//m:sheetView/m:pane", NS)
c.add(
    "header frozen",
    pane is not None
    and pane.get("state") in ("frozen", "frozenSplit")
    and pane.get("ySplit") in ("1", "1.0")
    and pane.get("xSplit") in (None, "0"),
    str(pane.attrib if pane is not None else "no pane"),
)
c.finish()
