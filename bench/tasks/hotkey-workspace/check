#!/bin/bash
source "$(dirname "$0")/../../lib.sh"
active=$(hyprctl activeworkspace -j | jq -r .id)
terminals=$(hyprctl clients -j | jq -r '[.[] | select(.workspace.id == 4 and (.class | test("^(foot|Alacritty|com.mitchellh.ghostty|kitty)$")))] | length')
if [[ $active == "4" ]] && (( terminals >= 1 )); then
  verdict pass "on workspace 4 with $terminals terminal(s)"
else
  verdict fail "active workspace $active, $terminals terminal(s) on 4"
fi
